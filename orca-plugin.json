{
  "manifestVersion": 2,
  "id": "claude-theme",
  "publisher": "jiangwanyutao",
  "name": "Claude Theme for Orca",
  "version": "1.5.1",
  "execution": "data",
  "description": "Authentic Claude Code aesthetic for Orca: warm charcoal and ivory canvases, midnight and pure white variants, signature terracotta accents, full chat suite, terminal themes, and semantic folder icons.",
  "license": "MIT",
  "repository": "https://github.com/jiangwanyutao/orca-claude-theme",
  "engines": {
    "orca": ">=1.4.245"
  },
  "contributes": {
    "themes": [
      {
        "id": "claude-dark",
        "title": "Claude Dark",
        "path": "themes/claude-dark.json"
      },
      {
        "id": "claude-dark-midnight",
        "title": "Claude Dark (Midnight OLED)",
        "path": "themes/claude-dark-midnight.json"
      },
      {
        "id": "claude-light",
        "title": "Claude Light",
        "path": "themes/claude-light.json"
      },
      {
        "id": "claude-light-pure",
        "title": "Claude Light (Pure White)",
        "path": "themes/claude-light-pure.json"
      }
    ],
    "terminalThemes": [
      {
        "id": "claude-dark",
        "title": "Claude Dark",
        "path": "terminal/claude-dark.json"
      },
      {
        "id": "claude-dark-oled",
        "title": "Claude Dark (Midnight OLED)",
        "path": "terminal/claude-dark-oled.json"
      },
      {
        "id": "claude-light",
        "title": "Claude Light",
        "path": "terminal/claude-light.json"
      },
      {
        "id": "claude-light-charcoal",
        "title": "Claude Light (Charcoal Cursor)",
        "path": "terminal/claude-light-charcoal.json"
      }
    ],
    "iconThemes": [
      {
        "id": "claude-icons",
        "title": "Claude Icons",
        "path": "icons/theme.json"
      }
    ]
  },
  "capabilities": [],
  "icon": "images/icon.png",
  "cover": {
    "path": "images/cover.png",
    "alt": "Claude Theme for Orca preview showing the warm editor, file tree, terminal, and color palette"
  }
}
