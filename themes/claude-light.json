{
  "schemaVersion": 1,
  "base": "light",
  "tokens": {
    "--background": "#FAF9F5",
    "--editor-surface": "#FFFFFF",
    "--foreground": "#302D29",
    "--card": "#FFFFFF",
    "--card-foreground": "#302D29",
    "--popover": "#FFFFFF",
    "--popover-foreground": "#302D29",
    "--primary": "#A3442B",
    "--primary-foreground": "#FFFFFF",
    "--secondary": "#EAE7DE",
    "--secondary-foreground": "#302D29",
    "--muted": "#EAE7DE",
    "--muted-foreground": "#625D55",
    "--accent": "#F6F4EE",
    "--accent-foreground": "#302D29",
    "--border": "#D8D2C7",
    "--input": "#D8D2C7",
    "--ring": "#A3442B",

    "--sidebar": "#F0EEE6",
    "--sidebar-foreground": "#302D29",
    "--sidebar-primary": "#A3442B",
    "--sidebar-primary-foreground": "#FFFFFF",
    "--sidebar-accent": "#F6F4EE",
    "--sidebar-accent-foreground": "#302D29",
    "--sidebar-border": "#D8D2C7",
    "--sidebar-ring": "#A3442B",

    "--worktree-sidebar": "#F0EEE6",
    "--worktree-sidebar-foreground": "#302D29",
    "--worktree-sidebar-accent": "#F6F4EE",
    "--worktree-sidebar-accent-foreground": "#302D29",
    "--worktree-sidebar-active": "#E4DDD2",
    "--worktree-sidebar-border": "#D8D2C7",
    "--worktree-sidebar-active-border": "#A3442B",
    "--worktree-sidebar-ring": "#A3442B",

    "--tab-bar": "#F0EEE6",
    "--tab-active": "#FAF9F5",
    "--tab-active-foreground": "#302D29",
    "--tab-active-indicator": "#A3442B",
    "--tab-inactive": "#F0EEE6",
    "--tab-inactive-foreground": "#625D55",
    "--split-divider": "#D8D2C7",
    "--split-divider-hover": "#A3442B",
    "--host-badge": "#E4DDD2",
    "--host-badge-foreground": "#625D55",

    "--chat-user-message": "#EDE8DE",
    "--chat-inline-code": "#EAE7DE",
    "--chat-inline-code-foreground": "#302D29",
    "--chat-code-block": "#FFFFFF",
    "--text-link": "#91402B",

    "--diff-added": "#456832",
    "--diff-added-background": "#E5EDDC",
    "--diff-added-gutter": "#E5EDDC",
    "--diff-added-emphasis": "#CDDEBA",
    "--diff-removed": "#A33E34",
    "--diff-removed-background": "#F4E2DC",
    "--diff-removed-gutter": "#F4E2DC",
    "--diff-removed-emphasis": "#EBC8BD",

    "--git-decoration-added": "#456832",
    "--git-decoration-untracked": "#456832",
    "--git-decoration-modified": "#805D22",
    "--git-decoration-deleted": "#A33E34",
    "--git-decoration-renamed": "#315F87",
    "--git-decoration-copied": "#785389",
    "--git-decoration-ignored": "#625D55",

    "--chart-1": "#A3442B",
    "--chart-2": "#456832",
    "--chart-3": "#805D22",
    "--chart-4": "#315F87",
    "--chart-5": "#785389"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#625D55",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language"
      ],
      "settings": {
        "foreground": "#91402B"
      }
    },
    {
      "name": "Strings & Markup Inserted",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.raw",
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#456832"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#805D22"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#315F87"
      }
    },
    {
      "name": "Types & Classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#785389"
      }
    },
    {
      "name": "Variables & Punctuation",
      "scope": [
        "variable",
        "support.variable",
        "variable.other.property",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#302D29"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#91402B"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#A33E34"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#91402B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#91402B",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#625D55",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup Deleted & Invalid",
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#A33E34"
      }
    }
  ]
}
