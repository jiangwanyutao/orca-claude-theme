{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#262624",
    "--editor-surface": "#1A1A19",
    "--foreground": "#ECE9E0",
    "--card": "#30302D",
    "--card-foreground": "#ECE9E0",
    "--popover": "#30302D",
    "--popover-foreground": "#ECE9E0",
    "--primary": "#D97757",
    "--primary-foreground": "#201914",
    "--secondary": "#383833",
    "--secondary-foreground": "#ECE9E0",
    "--muted": "#383833",
    "--muted-foreground": "#B9B3A7",
    "--accent": "#2E2E2B",
    "--accent-foreground": "#ECE9E0",
    "--border": "#494840",
    "--input": "#494840",
    "--ring": "#D97757",

    "--sidebar": "#20201E",
    "--sidebar-foreground": "#ECE9E0",
    "--sidebar-primary": "#D97757",
    "--sidebar-primary-foreground": "#201914",
    "--sidebar-accent": "#2E2E2B",
    "--sidebar-accent-foreground": "#ECE9E0",
    "--sidebar-border": "#494840",
    "--sidebar-ring": "#D97757",

    "--worktree-sidebar": "#20201E",
    "--worktree-sidebar-foreground": "#ECE9E0",
    "--worktree-sidebar-accent": "#2E2E2B",
    "--worktree-sidebar-accent-foreground": "#ECE9E0",
    "--worktree-sidebar-active": "#2D2C28",
    "--worktree-sidebar-border": "#494840",
    "--worktree-sidebar-active-border": "#D97757",
    "--worktree-sidebar-ring": "#D97757",

    "--tab-bar": "#20201E",
    "--tab-active": "#262624",
    "--tab-active-foreground": "#ECE9E0",
    "--tab-active-indicator": "#D97757",
    "--tab-inactive": "#20201E",
    "--tab-inactive-foreground": "#B9B3A7",
    "--split-divider": "#494840",
    "--split-divider-hover": "#D97757",
    "--host-badge": "#3D332A",
    "--host-badge-foreground": "#B9B3A7",

    "--chat-user-message": "#33322E",
    "--chat-bold-foreground": "#FAF9F5",
    "--chat-muted-foreground": "#9E988D",
    "--chat-inline-code": "#33312C",
    "--chat-inline-code-foreground": "#EDA184",
    "--chat-code-block": "#1A1A19",
    "--chat-selection": "#493A30",
    "--chat-selection-foreground": "#ECE9E0",
    "--text-link": "#EDA184",

    "--diff-added": "#A4BF88",
    "--diff-added-background": "#293625",
    "--diff-added-gutter": "#293625",
    "--diff-added-emphasis": "#3D5235",
    "--diff-removed": "#E6A08B",
    "--diff-removed-background": "#3B2723",
    "--diff-removed-gutter": "#3B2723",
    "--diff-removed-emphasis": "#57352D",

    "--git-decoration-added": "#A4BF88",
    "--git-decoration-untracked": "#A4BF88",
    "--git-decoration-modified": "#D6B575",
    "--git-decoration-deleted": "#E6A08B",
    "--git-decoration-renamed": "#9FBBD1",
    "--git-decoration-copied": "#C5ACD4",
    "--git-decoration-ignored": "#B9B3A7",

    "--chart-1": "#D97757",
    "--chart-2": "#A4BF88",
    "--chart-3": "#D6B575",
    "--chart-4": "#9FBBD1",
    "--chart-5": "#C5ACD4"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#B9B3A7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language"
      ],
      "settings": {
        "foreground": "#EDA184"
      }
    },
    {
      "name": "Strings & Markup Inserted",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.raw",
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#A4BF88"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#D6B575"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#9FBBD1"
      }
    },
    {
      "name": "Types & Classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#C5ACD4"
      }
    },
    {
      "name": "Variables & Punctuation",
      "scope": [
        "variable",
        "support.variable",
        "variable.other.property",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#ECE9E0"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#EDA184"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#E6A08B"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#EDA184",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#EDA184",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#B9B3A7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup Deleted & Invalid",
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#E6A08B"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "parameters"
      ],
      "settings": {
        "foreground": "#D6B575"
      }
    },
    {
      "name": "Decorators & Annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#D97757"
      }
    },
    {
      "name": "Regular Expressions",
      "scope": [
        "string.regexp",
        "constant.regexp"
      ],
      "settings": {
        "foreground": "#8EC4B6"
      }
    }
  ]
}
